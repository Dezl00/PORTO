# Neon: use the pooled connection string at runtime and the direct string for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require"

# Cloudinary (server-only; never expose API_SECRET in the browser)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Single-owner admin credentials. Generate the hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""
AUTH_SECRET="replace-with-a-long-random-secret"

# Leave true while reviewing the visual demo without Neon; set false in production.
DEMO_MODE="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
